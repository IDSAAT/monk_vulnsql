
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monk's Vuln Lab | MyShop</title>

    <style>
        body {
            background: #000;
            color: #fff;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 40px 20px;
        }

        .container {
            max-width: 850px;
            margin: 0 auto;
            text-align: center;
        }

        .logo {
            color: #d4af37;
            font-family: Georgia, serif;
            font-size: 30px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        input {
            padding: 10px;
            width: 220px;
            max-width: 70%;
            background: #111;
            color: #fff;
            border: 1px solid #555;
            border-radius: 4px;
        }

        button {
            padding: 10px 16px;
            background: #d4af37;
            color: #000;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-top: 30px;
            text-align: left;
        }

        .product {
            border: 1px solid #444;
            border-radius: 6px;
            padding: 16px;
            background: #101010;
        }

        .product h3 {
            color: #d4af37;
        }

        .price {
            font-weight: bold;
        }

        .message {
            color: #fff;
            margin-top: 24px;
            overflow-wrap: anywhere;
        }

        a {
            color: #d4af37;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="logo">Monk's Vuln Lab</div>
        <h2>MyShop</h2>
        <p>Search our products</p>

        <form method="GET" action="/shop">
            <input
                type="text"
                name="q"
                placeholder="Search by name or category"
                value="{{ search_term }}"
            >
            <button type="submit">Search</button>
        </form>
tzmu
        {% if error %}
            <p class="message">Database error: {{ error }}</p>
        {% elif results %}
            <div class="products">
                {% for product in results %}
    

